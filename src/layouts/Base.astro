---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, SITE_URL, EMAILS, SOCIALS, CITIES, FLAGSHIP, FORMSPREE_ID, GA_ID, OG_IMAGE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects to emit alongside the site-wide Organization schema. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title = `${SITE.name} | ${SITE.tagline}`,
  description = SITE.description,
  jsonLd = [],
} = Astro.props;

// Canonical + absolute OG URLs. Astro.site comes from astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href.replace(/(.+)\/$/, '$1');
const ogImage = new URL(OG_IMAGE, Astro.site ?? SITE_URL).href;

// Site-wide Organization schema — helps Google render a knowledge panel and
// associate the six brands with the parent group.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE_URL,
  logo: ogImage,
  description: SITE.description,
  foundingDate: SITE.foundingYear,
  email: EMAILS.general,
  areaServed: CITIES.map((city) => ({ '@type': 'City', name: city })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: FLAGSHIP.locality,
    addressRegion: FLAGSHIP.region,
    addressCountry: FLAGSHIP.country,
  },
  // Only emit sameAs when we actually have verified profile URLs.
  ...(SOCIALS.some((s) => s.href)
    ? { sameAs: SOCIALS.filter((s) => s.href).map((s) => s.href) }
    : {}),
};

const schemas = [organizationSchema, ...jsonLd];
---

<!DOCTYPE html>
<html class="dark" lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0E0E0F" />
    <title>{title}</title>

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Form delivery config: Formspree id (empty ⇒ mailto fallback) -->
    <meta name="formspree-id" content={FORMSPREE_ID} />
    <meta name="fallback-email" content={EMAILS.general} />

    <!--
      Arm the scroll-reveal animation. Runs before first paint so there is no
      flash of visible-then-hidden content. The reveal CSS is scoped to this
      class, so if scripting is off, blocked, or errors, the page simply renders
      with everything visible — content is never trapped at opacity:0.
      The watchdog un-arms it if the reveal script never reports in.
    -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
      window.addEventListener('load', function () {
        setTimeout(function () {
          if (!window.__revealReady) document.documentElement.classList.remove('js-reveal');
        }, 2500);
      });
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
  </head>
  <body
    class="bg-background text-on-background font-body-lg antialiased overflow-x-hidden selection:bg-secondary selection:text-on-secondary"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-4 focus:left-4 focus:bg-secondary focus:text-on-secondary focus:px-5 focus:py-3 focus:font-button focus:uppercase focus:tracking-widest"
    >
      Skip to content
    </a>

    <Nav />
    <slot />
    <Footer />

    <!--
      Shared form handler.
      Primary: AJAX POST to Formspree when PUBLIC_FORMSPREE_ID is configured.
      Fallback: open the visitor's mail client with the enquiry pre-filled.
      An enquiry is never silently dropped, in either state.
    -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const id = document.querySelector('meta[name="formspree-id"]')?.getAttribute('content') || '';
        const fallbackEmail =
          document.querySelector('meta[name="fallback-email"]')?.getAttribute('content') || '';
        const endpoint = id ? `https://formspree.io/f/${id}` : '';

        /** Compose a mailto: URL from the form's own fields. */
        const buildMailto = (form: HTMLFormElement) => {
          const data = new FormData(form);
          const subject = String(data.get('_subject') || 'Website enquiry');
          const lines: string[] = [];
          data.forEach((value, key) => {
            if (key.startsWith('_')) return;
            const label = key.replace(/[_-]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
            lines.push(`${label}: ${value}`);
          });
          return `mailto:${fallbackEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        };

        document.querySelectorAll<HTMLFormElement>('form[data-ajax]').forEach((form) => {
          const note = document.createElement('p');
          note.className = 'mt-4 text-label-caps uppercase tracking-widest text-secondary';
          note.setAttribute('role', 'status');
          note.setAttribute('aria-live', 'polite');
          form.appendChild(note);

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!form.checkValidity()) { form.reportValidity(); return; }

            // No Formspree configured — hand off to the visitor's mail client
            // rather than failing silently.
            if (!endpoint) {
              note.textContent = 'Opening your email app to send this enquiry…';
              window.location.href = buildMailto(form);
              return;
            }

            const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
            const label = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
            note.textContent = '';

            try {
              const res = await fetch(endpoint, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' },
              });
              if (res.ok) {
                form.reset();
                note.textContent = 'Thank you — we will be in touch shortly.';
              } else {
                note.textContent = 'Could not send. Opening your email app instead…';
                window.location.href = buildMailto(form);
              }
            } catch {
              note.textContent = 'Network issue. Opening your email app instead…';
              window.location.href = buildMailto(form);
            } finally {
              if (btn) { btn.disabled = false; btn.textContent = label; }
            }
          });
        });
      });
    </script>

    <!-- Shared scroll-reveal + sticky-nav condensing -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Scroll-reveal.
        //
        // Deliberately geometry-based rather than IntersectionObserver: IO only
        // reports once the tab has actually been painted, so a page opened in a
        // background tab can sit at opacity:0 with its content invisible. A
        // rect check always resolves. rAF-throttled so scrolling stays cheap.
        const reveals = Array.from(document.querySelectorAll('.reveal'));
        let pending = false;

        // Tell the head watchdog the reveal is under control.
        window.__revealReady = true;

        const revealOnScroll = () => {
          pending = false;
          const threshold = window.innerHeight - 120;
          for (let i = reveals.length - 1; i >= 0; i--) {
            if (reveals[i].getBoundingClientRect().top < threshold) {
              reveals[i].classList.add('active');
              reveals.splice(i, 1); // stop measuring what's already shown
            }
          }
        };

        const queueReveal = () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(revealOnScroll);
        };

        window.addEventListener('scroll', queueReveal, { passive: true });
        window.addEventListener('resize', queueReveal, { passive: true });
        revealOnScroll();

        const nav = document.getElementById('main-nav');
        if (nav) {
          const onScroll = () => {
            nav.classList.toggle('py-2', window.scrollY > 50);
            nav.classList.toggle('py-4', window.scrollY <= 50);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      });
    </script>
  </body>
</html>
