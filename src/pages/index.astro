---
import { Image } from 'astro:assets';
import Programme from '../layouts/Programme.astro';
import Rise from '../components/programme/Rise.astro';
import SecHead from '../components/programme/SecHead.astro';
import HouseRow from '../components/programme/HouseRow.astro';
import { HOUSES, PRESS } from '../data/houses';
import heroHome from '../assets/images/hero-home.jpg';
import galleryLouve from '../assets/images/gallery-louve.jpg';
import galleryCosybox from '../assets/images/gallery-cosybox.jpg';

const description =
  'A collection of extraordinary hospitality experiences, shaped for modern India. Six houses — Louve, Cosy Box, Toy Room, Ophelia, Meette and Dodicci.';
---
<Programme title="Campbell India | Our Brands" description={description}>
  <section class="hero">
    <div class="hero-img">
      <div class="px"><Image src={heroHome} alt="" widths={[1200, 1800, 2400, 3000]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
    </div>
    <div class="hero-in">
      <div class="eyebrow rv-i">Hospitality &#183; Culture &#183; Experience</div>
      <Rise tag="h1" cls="dsp-xl" lines={['Places people', ['remember.', true]]} />
      <p class="hero-sub rv-i">A collection of extraordinary hospitality experiences, shaped for modern India.</p>
    </div>
    <div class="hero-foot"><span>01 &#8212; 06</span><span class="cue"></span></div>
  </section>

  <section class="sec" id="the-house"><div class="wrap">
    <SecHead n="&#8212;" title="Introduction" />
    <div class="split">
      <div><Rise tag="h2" cls="dsp-l" lines={['Six houses.', ['Infinite ways to', true], ['experience hospitality.', true]]} /></div>
      <div class="rv-i">
        <p class="lede" style="margin-bottom:26px">Campbell India creates and operates hospitality destinations designed to be remembered.</p>
        <p class="body">From refined dining and artisanal patisserie to high-energy nightlife, every house has its own personality, purpose and point of view.</p>
        <p class="body">What connects them is simple — exceptional spaces, thoughtful food, considered service and experiences that stay with you.</p>
      </div>
    </div>
    <div class="plate" style="margin-top:clamp(48px,7vw,88px)">
      <div class="px"><Image src={galleryLouve} alt="" widths={[1200, 1800, 2400, 3000]} sizes="100vw" style="aspect-ratio:21/8" /></div>
    </div>
  </div></section>

  <section class="sec" id="the-houses" style="padding-top:0;padding-bottom:0"><div class="wrap">
    <SecHead n="01 &#8212; 06" title="Our Brands" />
    <div class="bill">{HOUSES.map((x) => <HouseRow house={x} />)}</div>
  </div></section>

  {/* --- back matter: the notices --- */}
  <section class="sec" style="padding-top:0"><div class="wrap">
    <SecHead n="&#8212;" title="In Good Company" />
    <div class="notices">
      {PRESS.map(([name, detail]) => (
        <div class="notice rv-i">
          <div class="cite">{name}</div>
          <div class="src">{detail}</div>
        </div>
      ))}
    </div>
  </div></section>

  {/* --- back matter: the appeal --- */}
  <section class="sec" style="padding-top:0"><div class="wrap">
    <SecHead n="&#8212;" title="Partnerships" />
    <div class="appeal">
      <figure class="plate">
        <Image src={galleryCosybox} alt="" widths={[600, 900, 1200]} sizes="(max-width:860px) 92vw, 44vw" style="aspect-ratio:4/3" />
      </figure>
      <div class="rv-i">
        <Rise tag="h2" cls="dsp-m" lines={["Let's create something", ['worth talking about.', true]]} />
        <p class="body" style="margin-top:26px">From private dining and celebrations to brand collaborations, cultural events and media partnerships, Campbell works with brands and people who share a passion for creating memorable experiences.</p>
        <div class="tags">
          {['Private Events', 'Brand Collaborations', 'Media & Press', 'Partnerships'].map((t) => <span class="pill">{t}</span>)}
        </div>
        <p><a href="/contact" class="enter">Start a conversation <span class="ar">&#8594;</span></a></p>
      </div>
    </div>
  </div></section>

  {/* --- back matter: the colophon --- */}
  <section><div class="wrap">
    <div class="colophon">
      <Rise tag="h2" cls="dsp-l" lines={['Six houses.', ['One hospitality philosophy.', true]]} />
      <div class="rv-i">
        <p>Different names. Different worlds. Different ways of bringing people together.</p>
        <p style="margin-top:1.1em">But behind them all is Campbell India.</p>
        <p><a href="/brands" class="enter">Discover the houses <span class="ar">&#8594;</span></a></p>
      </div>
    </div>
  </div></section>
</Programme>
