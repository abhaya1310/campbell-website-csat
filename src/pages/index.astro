---
import { Image } from 'astro:assets';
import Programme from '../layouts/Programme.astro';
import Rise from '../components/programme/Rise.astro';
import SecHead from '../components/programme/SecHead.astro';
import HouseRow from '../components/programme/HouseRow.astro';
import Band from '../components/programme/Band.astro';
import Note from '../components/programme/Note.astro';
import { HOUSES, CITY_MAP, PILLARS } from '../data/houses';
import atmosphere from '../assets/images/atmosphere.jpg';
import galleryLouve from '../assets/images/gallery-louve.jpg';

const description =
  'Six houses under one name — Louve, Cosy Box, Toy Room, Ophelia, Meette and Dodicci. Dining, patisserie and nightlife across five Indian cities.';
---
<Programme title="Campbell India | The Houses" description={description}>
  <section class="hero">
    <div class="hero-img">
      <div class="px"><Image src={atmosphere} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
    </div>
    <div class="hero-in">
      <div class="eyebrow rv-i">Campbell India &#183; The Season</div>
      <Rise tag="h1" cls="dsp-xl" lines={['The Houses.']} />
      <p class="hero-sub rv-i">Six worlds under one name. Dining, patisserie and nightlife across five Indian cities.</p>
    </div>
    <div class="hero-foot"><span>01 &#8212; 06</span><span class="cue"></span></div>
  </section>

  <section class="sec" id="the-house"><div class="wrap">
    <SecHead n="&#8212;" title="The House" />
    <div class="split">
      <div><Rise tag="h2" cls="dsp-l" lines={['Six houses.', ['One standard.', true]]} /></div>
      <div class="rv-i">
        <p class="lede" style="margin-bottom:26px">Campbell Property &amp; Hospitality was founded in 2019. It runs six houses across five Indian cities.</p>
        <p class="body">A flagship in New Delhi. A Cannes import in four cities. An internationally recognised club. A Renaissance restaurant and bar. An atelier patisserie working since 2015. And one house still taking shape.</p>
        <Note title="Copy status">
          Every outlet detail on this site — name, category, location, status and body copy — is verbatim from the copy Campbell supplied. Only the one-line taglines are new, and each compresses that house&#8217;s own paragraph.
        </Note>
      </div>
    </div>
    <div class="plate" style="margin-top:clamp(48px,7vw,88px)">
      <div class="px"><Image src={galleryLouve} alt="" widths={[900, 1400, 2000]} sizes="100vw" style="aspect-ratio:21/8" /></div>
    </div>
  </div></section>

  <section class="sec" id="the-houses" style="padding-top:0;padding-bottom:0"><div class="wrap">
    <SecHead n="01 &#8212; 06" title="The Houses" />
    <div class="bill">{HOUSES.map((x) => <HouseRow house={x} />)}</div>
  </div></section>

  <Band quote="Six houses, one standard of luxury." attr="Campbell Property &amp; Hospitality" />

  <section class="sec"><div class="wrap">
    <SecHead n="&#8212;" title="What we do" />
    <div class="g3">
      {PILLARS.map(([name, copy], i) => (
        <div class="pillar rv-i">
          <div class="eyebrow" style="margin-bottom:14px">0{i + 1}</div>
          <h4>{name}</h4>
          <p class="body">{copy}</p>
        </div>
      ))}
    </div>
  </div></section>

  <section class="sec" id="locations" style="padding-top:0"><div class="wrap">
    <SecHead n="&#8212;" title="Where to find us" />
    <div class="split" style="margin-bottom:44px">
      <Rise tag="h2" cls="dsp-m" lines={['Five cities.', ['Six houses.', true]]} />
      <div class="rv-i">
        <Note title="Unverified">
          The city-to-house mapping below is read off Campbell&#8217;s own brand copy. Exact room counts and street addresses per city have never been supplied, and none are stated here.
        </Note>
      </div>
    </div>
    <div class="cities rv-i">
      {CITY_MAP.map(([city, houses]) => <div><div class="cn">{city}</div><div class="cc">{houses}</div></div>)}
    </div>
  </div></section>
</Programme>
