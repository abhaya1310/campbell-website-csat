---
import Programme from '../layouts/Programme.astro';
import Rise from '../components/programme/Rise.astro';
import SecHead from '../components/programme/SecHead.astro';
import { SITE, SITE_URL, EMAILS, PHONE, OFFICE_HOURS, CITIES, FORMSPREE_ID } from '../config/site';

const description =
  'Get in touch with Campbell India for private events, brand partnerships, franchise opportunities and press enquiries.';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE_URL}/contact#page`,
  name: `Contact ${SITE.name}`,
  description,
  mainEntity: { '@id': `${SITE_URL}/#organization` },
}];

/**
 * An enquiry needs somewhere to GO. With no Formspree endpoint and no verified
 * address, a form would silently swallow every message — so the form renders
 * only when a real destination exists. Set PUBLIC_FORMSPREE_ID, or put a
 * confirmed address in EMAILS.general, and it appears.
 */
const canReceive = Boolean(FORMSPREE_ID || EMAILS.general);
const ENQUIRIES = [
  ['General', EMAILS.general],
  ['Private events & reservations', EMAILS.events],
  ['Brand partnerships & franchise', EMAILS.partnerships],
  ['Press & media', EMAILS.press],
] as [string, string][];
const listed = ENQUIRIES.filter(([, addr]) => addr);
---
<Programme title="Enquiries | Campbell India" description={description} jsonLd={schema}>
  <section class="sec pagehead"><div class="wrap">
    <div class="eyebrow rv-i">Campbell India &#183; Enquiries</div>
    <Rise tag="h1" cls="dsp-l" lines={['Get in touch.']} />
    <p class="lede rv-i" style="margin-top:22px;max-width:44ch">We welcome enquiries for private events, brand partnerships, franchise opportunities and press.</p>
  </div></section>

  <section class="sec" style="padding-top:0"><div class="wrap">
    <SecHead n="01" title="Reach us" />
    <div class="split">
      <div class="rv-i">
        {listed.length ? (
          <ul class="contact-list">
            {listed.map(([label, addr]) => (
              <li><span class="eyebrow">{label}</span><a class="clink" href={`mailto:${addr}`}>{addr}</a></li>
            ))}
            {PHONE && <li><span class="eyebrow">Telephone</span><a class="clink" href={`tel:${PHONE.replace(/\s/g, '')}`}>{PHONE}</a></li>}
          </ul>
        ) : (
          <p class="lede" style="max-width:30ch">Enquiries are welcomed at any of our houses.</p>
        )}
        <p class="body" style="margin-top:26px">{OFFICE_HOURS.days}, {OFFICE_HOURS.hours}</p>
        <p class="body">{CITIES.join('\u00A0\u00B7 ')}</p>
      </div>

      <div class="rv-i">
        {canReceive ? (
          <form class="enq" id="enq" method="POST" action={FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : undefined}>
            <label><span class="eyebrow">Name</span><input name="name" required autocomplete="name" /></label>
            <label><span class="eyebrow">Email</span><input name="email" type="email" required autocomplete="email" /></label>
            <label><span class="eyebrow">Telephone</span><input name="phone" type="tel" autocomplete="tel" /></label>
            <label><span class="eyebrow">Nature of enquiry</span>
              <select name="subject">
                <option>General enquiry</option>
                <option>Private events &amp; reservations</option>
                <option>Brand partnership</option>
                <option>Franchise &amp; expansion</option>
                <option>Press &amp; media</option>
                <option>Careers</option>
              </select>
            </label>
            <label><span class="eyebrow">Message</span><textarea name="message" rows="5" required></textarea></label>
            <button class="enter" type="submit">Send enquiry <span class="ar">&#8594;</span></button>
            <p class="formnote" hidden data-status></p>
          </form>
        ) : (
          <p class="body">For private events, partnerships and press, please contact the house directly or write to us and we will route your enquiry to the right team.</p>
        )}
      </div>
    </div>
  </div></section>
</Programme>

<script>
  // Progressive: Formspree over fetch when configured, native POST otherwise.
  document.addEventListener('astro:page-load', () => {
    const f = document.getElementById('enq') as HTMLFormElement | null;
    if (!f || !f.action || f.dataset.bound) return;
    f.dataset.bound = '1';
    const status = f.querySelector('[data-status]') as HTMLElement | null;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      try {
        const res = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        f.reset();
        if (status) { status.hidden = false; status.textContent = 'Thank you. Your enquiry has been sent.'; }
      } catch {
        if (status) { status.hidden = false; status.textContent = 'That did not send. Please try again, or email us directly.'; }
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
