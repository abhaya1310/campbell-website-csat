---
/**
 * A house page.
 *
 * It renders ONLY what Campbell has actually supplied. Sections that had no
 * copy (food & drinks, the experience, occasions, address and hours) used to
 * render as designed "copy required" holds — useful while briefing, wrong on
 * a live client site — so they are gone until the content exists. The section
 * rail went with them: six unlabelled numerals could not say what they linked
 * to, and a page of three sections does not need a rail at all.
 */
import { Image } from 'astro:assets';
import Programme from '../../layouts/Programme.astro';
import Rise from '../../components/programme/Rise.astro';
import SecHead from '../../components/programme/SecHead.astro';
import Band from '../../components/programme/Band.astro';
import { HOUSES } from '../../data/houses';
import { SITE_URL } from '../../config/site';

export function getStaticPaths() {
  return HOUSES.map((h) => ({ params: { slug: h.slug }, props: { h } }));
}
const { h } = Astro.props;
const i = HOUSES.indexOf(h);
const prev = HOUSES[(i + HOUSES.length - 1) % HOUSES.length];
const next = HOUSES[(i + 1) % HOUSES.length];

const schema = h.schemaType
  ? [{
      '@context': 'https://schema.org',
      '@type': h.schemaType,
      '@id': `${SITE_URL}/brands/${h.slug}`,
      name: h.name,
      description: h.body[0],
      url: `${SITE_URL}/brands/${h.slug}`,
      ...(h.cuisine.length ? { servesCuisine: h.cuisine } : {}),
      parentOrganization: { '@id': `${SITE_URL}/#organization` },
    }]
  : [];
---
<Programme title={`${h.name} | Campbell India`} description={`${h.name} — ${h.category}, ${h.location}. ${h.body[0]}`} house={h.slug} jsonLd={schema}>
  <div class="frame">
  <section class="hero" style={`--house:${h.ink}`}>
    {h.hero && (
      <div class="hero-img">
        <div class="px"><Image src={h.hero} alt={`${h.name}, ${h.location}`} widths={[1200, 1800, 2400, 3000]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
      </div>
    )}
    <div class="hero-in">
      <div class="eyebrow rv-i">{h.n} &#183; {h.category} &#183; {h.location}</div>
      <Rise tag="h1" cls="dsp-xl" lines={[`${h.name}.`]} />
      <p class="hero-sub rv-i">{h.tagline}</p>
    </div>
    <div class="hero-foot"><span>Campbell &#8212; Brand {h.n} of 06</span><span class="cue"></span></div>
  </section>
  </div>

  <div style={`--house:${h.ink}`}>
    <section class="sec"><div class="wrap">
      <SecHead n="01" title="About" />
      <div class="split">
        <div class="rv-i">
          <div class="hr-n num" style="font-size:clamp(3.2rem,6.5vw,5.6rem);opacity:.26;margin-bottom:6px">{h.n}</div>
          <Rise tag="h2" cls="dsp-m" lines={[`${h.category}.`]} />
          <div class="hr-meta" style="margin-top:22px">{h.tags.map((t) => <span class="pill">{t}</span>)}</div>
        </div>
        <div class="rv-i">
          {h.body.map((b) => <p class="body">{b}</p>)}
        </div>
      </div>
    </div></section>

    {h.cuisine.length > 0 && (
      <section class="sec" style="padding-top:0"><div class="wrap">
        <SecHead n="02" title="The Table" />
        <div class="split">
          <div><Rise tag="h2" cls="dsp-m" lines={h.cuisine.map((c) => `${c}.`)} /></div>
          <div></div>
        </div>
      </div></section>
    )}
  </div>

  <Band quote={h.pull} attr={`${h.name} &#183; Brand ${h.n}`} ink={h.ink} />

  {h.gallery.length > 0 && (
    <section class="sec" style={`--house:${h.ink}`}><div class="wrap">
      <SecHead n={h.cuisine.length ? '03' : '02'} title="The Room" />
      <div class={h.gallery.length > 1 ? 'g2' : ''}>
        {h.gallery.map((g, k) => (
          <figure class="plate">
            <Image src={g} alt={`${h.name} interior`} widths={[1200, 1800, 2400, 3000]} sizes={h.gallery.length > 1 ? '(max-width:620px) 92vw, 46vw' : '100vw'} style={h.gallery.length > 1 ? `aspect-ratio:${k % 2 ? '3/4' : '4/3'}` : 'aspect-ratio:21/9'} />
          </figure>
        ))}
      </div>
    </div></section>
  )}

  <nav class="nextprod" aria-label="Other houses">
    <a href={`/brands/${prev.slug}`}><div class="k">&#8592; Brand {prev.n}</div><div class="v">{prev.name}</div></a>
    <a href={`/brands/${next.slug}`} class="r"><div class="k">Brand {next.n} &#8594;</div><div class="v">{next.name}</div></a>
  </nav>
</Programme>
