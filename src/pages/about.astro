---
import { Image } from 'astro:assets';
import Programme from '../layouts/Programme.astro';
import Rise from '../components/programme/Rise.astro';
import SecHead from '../components/programme/SecHead.astro';
import Band from '../components/programme/Band.astro';
import { SITE, SITE_URL } from '../config/site';
import { HOUSES, PILLARS } from '../data/houses';
import atmosphere from '../assets/images/atmosphere.jpg';
import galleryCosybox from '../assets/images/gallery-cosybox.jpg';

const description =
  'Founded in 2019, Campbell India operates at the intersection of fine dining, lifestyle and entertainment — from Michelin-style cuisine to world-renowned nightlife across Delhi, Mumbai, Kolkata and Pune.';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/about#page`,
  name: `About ${SITE.name}`,
  description,
  mainEntity: { '@id': `${SITE_URL}/#organization` },
}];
---
<Programme title="The House | Campbell India" description={description} jsonLd={schema}>
  <section class="hero hero-short">
    <div class="hero-img"><div class="px"><Image src={atmosphere} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" /></div></div>
    <div class="hero-in">
      <div class="eyebrow rv-i">Since 2019</div>
      <Rise tag="h1" cls="dsp-l" lines={['A passion for', ['unforgettable hospitality.', true]]} />
    </div>
  </section>

  <section class="sec"><div class="wrap">
    <SecHead n="&#8212;" title="Background" />
    <div class="split">
      <div><Rise tag="h2" cls="dsp-m" lines={['Built at the intersection of', ['dining, lifestyle', true], ['and entertainment.', true]]} /></div>
      <div class="rv-i">
        <p class="body">Founded with a passion for creating unforgettable hospitality experiences, our brand portfolio includes Cosy Box, Ophelia, Toy Room, Meette, Louve and Dodicci — each uniquely positioned at the intersection of fine dining, lifestyle and entertainment.</p>
        <p class="body">From Michelin-style cuisine to world-renowned nightlife, our presence in major cities like Delhi, Mumbai, Kolkata and Pune reflects a deep understanding of urban tastes and a commitment to delivering elevated, culturally resonant experiences.</p>
      </div>
    </div>
    <div class="plate" style="margin-top:clamp(48px,7vw,88px)">
      <div class="px"><Image src={galleryCosybox} alt="Interior detail from Cosy Box" widths={[900, 1400, 2000]} sizes="100vw" style="aspect-ratio:21/8" /></div>
    </div>
  </div></section>

  <Band quote="Operating at the forefront of India's evolving luxury hospitality landscape." attr="Campbell Property &amp; Hospitality" />

  <section class="sec"><div class="wrap">
    <SecHead n="&#8212;" title="What we do" />
    <div class="g3">
      {PILLARS.map(([name, copy], i) => (
        <div class="pillar rv-i">
          <div class="eyebrow" style="margin-bottom:14px">0{i + 1}</div>
          <h4>{name}</h4>
          <p class="body">{copy}</p>
        </div>
      ))}
    </div>
  </div></section>

  <section class="sec" style="padding-top:0"><div class="wrap">
    <SecHead n="01 &#8212; 06" title="The Houses" />
    <div class="cities rv-i">
      {HOUSES.map((x) => (
        <div style={`--house:${x.ink}`}>
          <div class="cn"><a href={`/brands/${x.slug}`}>{x.name}</a></div>
          <div class="cc">{x.category} &#183; {x.location}</div>
        </div>
      ))}
    </div>
  </div></section>
</Programme>
