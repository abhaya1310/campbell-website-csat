---
import { Image } from 'astro:assets';
import Programme from '../layouts/Programme.astro';
import Rise from '../components/programme/Rise.astro';
import SecHead from '../components/programme/SecHead.astro';
import { SITE, SITE_URL } from '../config/site';
import { HOUSES, PILLARS, STANDARDS } from '../data/houses';
import atmosphere from '../assets/images/atmosphere.jpg';
import galleryCosybox from '../assets/images/gallery-cosybox.jpg';

const description =
  'Campbell India creates and operates hospitality destinations designed to be remembered — from refined dining and artisanal patisserie to high-energy nightlife.';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/about#page`,
  name: `About ${SITE.name}`,
  description,
  mainEntity: { '@id': `${SITE_URL}/#organization` },
}];
---
<Programme title="The House | Campbell India" description={description} jsonLd={schema}>
  <section class="hero hero-short">
    <div class="hero-img"><div class="px"><Image src={atmosphere} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" /></div></div>
    <div class="hero-in">
      <div class="eyebrow rv-i">Since 2019</div>
      <Rise tag="h1" cls="dsp-l" lines={['A passion for', ['unforgettable hospitality.', true]]} />
    </div>
  </section>

  <section class="sec"><div class="wrap">
    <SecHead n="&#8212;" title="Background" />
    <div class="split">
      <div><Rise tag="h2" cls="dsp-m" lines={['Six houses.', ['Infinite ways to', true], ['experience hospitality.', true]]} /></div>
      <div class="rv-i">
        <p class="body">Campbell India creates and operates hospitality destinations designed to be remembered.</p>
        <p class="body">From refined dining and artisanal patisserie to high-energy nightlife, every house has its own personality, purpose and point of view.</p>
        <p class="body">What connects them is simple — exceptional spaces, thoughtful food, considered service and experiences that stay with you.</p>
      </div>
    </div>
    <div class="plate" style="margin-top:clamp(48px,7vw,88px)">
      <div class="px"><Image src={galleryCosybox} alt="Interior detail from Cosy Box" widths={[900, 1400, 2000]} sizes="100vw" style="aspect-ratio:21/8" /></div>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <SecHead n="&#8212;" title="Our World" />
    <div class="index">
      {PILLARS.map(([name, copy], i) => (
        <div class="idx rv-i">
          <span class="fol">0{i + 1}</span>
          <h4>{name}</h4>
          <p>{copy}</p>
        </div>
      ))}
    </div>
  </div></section>

  <section class="leaf" data-band="1"><div class="wrap">
    <SecHead n="&#8212;" title="The Campbell Standard" />
    <Rise tag="h2" cls="dsp-m" lines={['What brings every', ['house together?', true]]} />
    <div class="tenets">
      {STANDARDS.map(([name, copy]) => (
        <div class="tenet rv-i">
          <h4>{name}</h4>
          <p>{copy}</p>
        </div>
      ))}
    </div>
  </div></section>

  <section class="sec" style="padding-top:0"><div class="wrap">
    <SecHead n="01 &#8212; 06" title="The Houses" />
    <div class="cities rv-i">
      {HOUSES.map((x) => (
        <div style={`--house:${x.ink}`}>
          <div class="cn"><a href={`/brands/${x.slug}`}>{x.name}</a></div>
          <div class="cc">{x.category} &#183; {x.location}</div>
        </div>
      ))}
    </div>
  </div></section>
</Programme>
