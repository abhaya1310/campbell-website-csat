---
import { SITE, EMAILS, SOCIALS } from '../config/site';

// Only render socials the client has actually supplied — never a dead href="#".
const activeSocials = SOCIALS.filter((s) => s.href);

const brandLinks = [
  { href: '/brands#louve', label: 'Louve' },
  { href: '/brands#cosy-box', label: 'Cosy Box' },
  { href: '/brands#toy-room', label: 'Toy Room' },
  { href: '/brands#ophelia', label: 'Ophelia' },
  { href: '/brands#meette', label: 'Meette' },
  { href: '/brands#dodicci', label: 'Dodicci' },
];

const ICON_PATHS: Record<string, string> = {
  instagram:
    'M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z',
  facebook:
    'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
};

const year = new Date().getFullYear();
---

<footer class="w-full py-16 bg-surface-container-lowest grid grid-cols-1 md:grid-cols-12 gap-12 px-gutter max-w-container-max mx-auto border-t border-secondary/20">
  <!-- Brand & Info -->
  <div class="md:col-span-4 flex flex-col justify-between">
    <div>
      <a class="font-headline-lg text-headline-lg text-primary block mb-6 tracking-[0.12em] uppercase" href="/">
        {SITE.name}
      </a>
      <div class="font-body-md text-on-surface-variant space-y-2 mb-8">
        <p>{SITE.tagline} · Since {SITE.foundingYear}</p>
        <p>
          <a class="hover:text-primary transition-colors" href={`mailto:${EMAILS.general}`}>
            {EMAILS.general}
          </a>
        </p>
      </div>
    </div>
    <p class="font-label-caps text-[10px] text-on-surface-variant opacity-60 tracking-[0.2em] uppercase">
      © {year} {SITE.legalName}. All rights reserved.
    </p>
  </div>

  <!-- Links -->
  <div class="md:col-span-4 grid grid-cols-2 gap-8">
    <div>
      <h4 class="font-label-caps text-secondary mb-6 tracking-widest uppercase">Navigation</h4>
      <ul class="space-y-4 font-body-md text-sm text-on-surface-variant">
        <li><a class="hover:text-primary transition-colors" href="/brands">Brands</a></li>
        <li><a class="hover:text-primary transition-colors" href="/about">About</a></li>
        <li><a class="hover:text-primary transition-colors" href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-label-caps text-secondary mb-6 tracking-widest uppercase">Brands</h4>
      <ul class="space-y-4 font-body-md text-sm text-on-surface-variant">
        {brandLinks.map((b) => (
          <li><a class="hover:text-primary transition-colors" href={b.href}>{b.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Newsletter & Socials -->
  <div class="md:col-span-4 flex flex-col justify-between">
    <div class="mb-8">
      <h4 class="font-label-caps text-secondary mb-6 tracking-widest uppercase">The Campbell Circle</h4>
      <p class="font-body-md text-sm text-on-surface-variant mb-4">
        Subscribe for openings, private events, and invitations across our houses.
      </p>
      <form class="flex border-b border-outline-variant/30 pb-2 group" data-ajax>
        <input type="hidden" name="_subject" value="Campbell India — Newsletter signup" />
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          class="bg-transparent border-none w-full text-primary placeholder:text-on-surface-variant/50 focus:ring-0 px-0 font-body-md group-focus-within:border-secondary transition-colors"
          id="newsletter-email"
          placeholder="Email Address"
          required
          type="email"
          name="email_address"
        />
        <button class="text-secondary hover:text-primary transition-colors ml-4" type="submit" aria-label="Subscribe">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </button>
      </form>
    </div>

    <div class="flex gap-6 items-center text-on-surface-variant">
      {activeSocials.map((s) => (
        <a
          class="hover:text-secondary transition-colors"
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={ICON_PATHS[s.icon]} />
          </svg>
        </a>
      ))}
      <a class="hover:text-secondary transition-colors" href={`mailto:${EMAILS.general}`} aria-label="Email us">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
      </a>
    </div>
  </div>
</footer>
