---
/**
 * A section label. Just the running head over a hairline — the numeral column
 * is gone (ruled 2026-09-15: a dash standing in for a missing number read as
 * a typo, and a page of three sections does not need counting).
 */
interface Props { title: string; id?: string }
const { title, id } = Astro.props;
---
<div class="sechead" id={id}><span class="eyebrow">{title}</span></div>
