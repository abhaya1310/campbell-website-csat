---
import { SITE } from '../config/site';

const links = [
  { href: '/brands', label: 'Brands' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

// Mark the active page so visitors know where they are.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav
  class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-xl border-b border-outline-variant/20 shadow-2xl shadow-black/50 transition-all duration-300"
  id="main-nav"
>
  <div class="flex justify-between items-center px-gutter py-4 w-full max-w-container-max mx-auto">
    <!-- Mobile: menu toggle -->
    <button
      type="button"
      id="mobile-menu-toggle"
      class="md:hidden text-primary hover:opacity-80 transition-all duration-300 -ml-1 p-1"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
    </button>

    <!-- Brand logo -->
    <a
      class="font-headline-md text-headline-md text-primary tracking-[0.18em] uppercase"
      href="/"
      aria-label={`${SITE.name} — home`}
    >
      {SITE.name}
    </a>

    <!-- Desktop navigation -->
    <div class="hidden md:flex items-center space-x-8">
      {links.map((link) => (
        <a
          class:list={[
            'font-button text-button uppercase tracking-widest transition-colors duration-300 hover:text-secondary',
            path === link.href ? 'text-secondary' : 'text-on-surface hover:opacity-80',
          ]}
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTA -->
    <a
      class="hidden md:inline-flex solid-button px-6 py-3 font-button text-button uppercase tracking-widest z-10"
      href="/contact"
    >
      Enquire
    </a>

    <!-- Mobile CTA -->
    <a
      class="md:hidden text-primary hover:opacity-80 transition-all duration-300 -mr-1 p-1"
      href="/contact"
      aria-label="Make an enquiry"
    >
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">mail</span>
    </a>
  </div>

</nav>

<!--
  Mobile drawer — deliberately a SIBLING of <nav>, not a child.
  <nav> carries backdrop-blur, which makes it a containing block for fixed
  descendants: nested here, `inset-0` would resolve to the ~90px nav bar
  instead of the viewport, painting the backdrop as a thin strip while the
  menu content spilled out over the page.
-->
<div
    id="mobile-menu"
    class="md:hidden fixed inset-0 z-[60] bg-background opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col"
    aria-hidden="true"
  >
    <div class="flex justify-between items-center px-gutter py-4 border-b border-outline-variant/20">
      <span class="font-headline-md text-headline-md text-primary tracking-[0.18em] uppercase">
        {SITE.name}
      </span>
      <button
        type="button"
        id="mobile-menu-close"
        class="text-primary hover:opacity-80 transition-all duration-300 -mr-1 p-1"
        aria-label="Close menu"
      >
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="flex-1 flex flex-col justify-center px-gutter gap-2">
      {links.map((link, i) => (
        <a
          class:list={[
            'font-display-lg-mobile text-5xl py-4 border-b border-outline-variant/20 transition-colors duration-300',
            path === link.href ? 'text-secondary' : 'text-primary hover:text-secondary',
          ]}
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
          data-menu-index={i}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="px-gutter pb-12 pt-6">
      <a
        class="solid-button w-full inline-flex justify-center px-8 py-4 font-button text-button uppercase tracking-widest"
        href="/contact"
      >
        Make an Enquiry
      </a>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const close = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('pointer-events-none', !open);
      menu.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      // Lock background scroll while the drawer is up.
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLAnchorElement>('[data-menu-index="0"]')?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));

    // Escape closes, and any navigation click releases the scroll lock.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.getAttribute('aria-hidden') === 'false') setOpen(false);
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        document.body.style.overflow = '';
      }),
    );
  });
</script>
